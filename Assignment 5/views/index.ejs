<section class="hero">
  <div class="hero__content">
    <h1>Get the Best Insurance for Your Family</h1>
    <p>Simple, clear plans to protect the people you love.</p>
    <div class="hero__actions">
      <a href="/login" class="btn btn-primary">Login</a>
      <a href="/register" class="btn btn-outline">Create Account</a>
    </div>
  </div>
  <div class="hero__highlight">
    <h2>How it works</h2>
    <ul>
      <li>1. Create an account</li>
      <li>2. Login to see plans</li>
      <li>3. Choose and save a plan</li>
    </ul>
  </div>
</section>

<section class="section">
  <h2 class="section__title">Popular Insurance Plans</h2>
  <div class="cards-grid">
    <% if (plans && plans.length) { %>
      <% plans.forEach((plan) => { %>
        <article class="card">
          <h3 class="card__title"><%= plan.planName %></h3>
          <p class="card__price">₹ <%= plan.price %></p>
          <p class="card__duration"><%= plan.duration %></p>
          <p class="card__description"><%= plan.description %></p>
        </article>
      <% }) %>
    <% } else { %>
      <p class="section__intro">Plans will appear here after you add them.</p>
    <% } %>
  </div>
</section>

